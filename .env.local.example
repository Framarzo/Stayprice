# Copia questo file in .env.local e incolla i tuoi valori.
# .env.local non va mai caricato su GitHub (è già escluso da .gitignore).

# Da Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Da serpapi.com → dashboard, "Private API Key" (fonte principale prezzi voli, Google Flights)
SERPAPI_KEY=

# Facoltativo — da travelpayouts.com → Profilo → API token (fonte di riserva, dati in cache)
TRAVELPAYOUTS_TOKEN=
